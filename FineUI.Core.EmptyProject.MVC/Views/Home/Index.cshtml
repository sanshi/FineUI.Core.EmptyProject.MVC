@{
    ViewBag.Title = "首页";
    var F = @Html.F();
}

@section head {

    <link type="text/css" rel="stylesheet" href="~/res/css/index.css" />

    @* 欢迎页样式与公开的 FineUI.Core RazorForms 默认示例保持一致 *@
    <style>
        .intro { max-width: 920px; margin: 0 auto; padding: 32px 24px 48px; color: var(--f-content-text-color); font-size: 14px; line-height: 1.7; }

        .position { max-width: 840px; margin: 28px auto 4px; text-align: center; }
        .position .headline { margin: 0; font-size: 24px; font-weight: 700; line-height: 1.5; letter-spacing: .2px; }
        .position .headline-detail { display: inline-block; margin-top: 2px; color: var(--f-content-text-color); font-size: 20px; font-weight: 600; }
        .position p { max-width: 760px; margin: 16px auto 0; color: var(--f-content-text-color); opacity: .72; }

        .capability-head { margin: 48px auto 0; text-align: center; }
        .capability-head h2 { margin: 0; color: var(--f-content-text-color); font-size: 24px; font-weight: 700; letter-spacing: .2px; }
        .capability-head p { margin: 0; color: var(--f-content-text-color); opacity: .65; }

        .features { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; margin: 30px 0 8px; }
        .feature { min-width: 0; padding: 20px 22px; border: 1px solid var(--f-content-border-color); border-radius: 12px; background: var(--f-content-background-color); box-shadow: 0 2px 12px rgba(20, 40, 55, .04); }
        .feature .ico { font-size: 24px; line-height: 1; }
        .feature h3 { margin: 10px 0 6px; color: var(--f-content-text-color); font-size: 16px; }
        .feature p { margin: 0; color: var(--f-content-text-color); font-size: 13px; opacity: .72; }

        .demo { margin: 40px 0 8px; }
        .demo .demo-title { margin-bottom: 14px; color: var(--f-content-text-color); font-size: 13px; text-align: center; opacity: .55; }
        .demo .code { padding: 18px 22px; overflow-x: auto; border: 1px solid var(--f-content-border-color); border-radius: 10px; background: #1e2a30; }
        .demo pre { margin: 0; color: #cfe3dc; font: 13px/1.75 Consolas, 'Courier New', monospace; white-space: pre; }
        .demo .cap { margin-top: 12px; color: var(--f-content-text-color); font-size: 12px; text-align: center; opacity: .55; }
        .k { color: #6fb3d2; }
        .a { color: #b3d78c; }
        .s { color: #e0a978; }
        .c { color: #7c8b93; }

        .foot { margin-top: 36px; color: var(--f-content-text-color); font-size: 13px; text-align: center; opacity: .55; }

        @@media (max-width: 640px) {
            .intro { padding: 24px 16px 36px; }
            .position { margin-top: 24px; }
            .position .headline { font-size: 20px; }
            .position .headline-detail { font-size: 17px; }
            .features { grid-template-columns: 1fr; }
        }
    </style>

}

@section body {

    <div id="sideheader" class="f-widget-header f-mainheader">
        <a class="logo" href="@Url.Content("~/")" title="FineUI.Core空项目">FineUI.Core空项目</a>
    </div>


    <div id="header" class="f-widget-header f-mainheader" style="display:none;">
        <div class="header-left">

        </div>
        <div class="header-right">
            @(F.Button().EnableDefaultCorner(false).EnableDefaultState(false).IconFont(IconFont._Skin).IconAlign(IconAlign.Top).ToolTip("主题仓库").ID("btnThemeSelect").CssClass("icononlyaction themes").ClickHandler("onThemeSelectClick"))

            @(F.Button().EnableDefaultCorner(false).EnableDefaultState(false).IconAlign(IconAlign.Left).IconUrl(Url.Content("~/res/images/my_face_80.jpg")).Text("三生石上").CssClass("userpicaction")
                .Menu(F.Menu()
                    .Items(
                        F.MenuButton().IconFont(IconFont._User).Text("个人信息").ClickHandler("onUserProfileClick"),
                        F.MenuSeparator(),
                        F.MenuButton().IconFont(IconFont._SignOut).Text("安全退出").ClickHandler("onSignOutClick")
                    )
                )
            )
        </div>
    </div>

    <div id="maincontent">
        <div class="intro">
            <div class="position">
                <h2 class="headline">FineUI.Core<br /><span class="headline-detail">「AI 友好 · 流式 API · 有状态」企业级全栈 UI 框架</span></h2>
            </div>

            <div class="capability-head">
                <p>AI 写得快，人类看得懂；用一致的流式 API 组合控件；事件直达后端，后端修改属性自动回传前端。</p>
            </div>

            <div class="features">
                <div class="feature">
                    <div class="ico">🏷️</div>
                    <h3>流式 API</h3>
                    <p>用链式方法配置控件、属性和子项，结构清楚、组合灵活，适合标准 ASP.NET Core MVC 项目。</p>
                </div>
                <div class="feature">
                    <div class="ico">🔄</div>
                    <h3>状态自动往返</h3>
                    <p>控件状态在前后端之间自动保持——后端直接读写控件属性、事件直达处理方法，像写桌面程序一样写 Web。</p>
                </div>
                <div class="feature">
                    <div class="ico">🤖</div>
                    <h3>AI 友好</h3>
                    <p>所有控件都遵循一致的流式调用规则——AI 好生成，人也看得懂。</p>
                </div>
                <div class="feature">
                    <div class="ico">⚙️</div>
                    <h3>ASP.NET Core 全栈</h3>
                    <p>一个依赖即可接入，不碰 JavaScript、无需前后端分离；控件状态不绑定单台服务器，天然支持水平扩展。</p>
                </div>
            </div>

            <div class="demo">
                <div class="demo-title">— 视图里声明控件，控制器里写事件方法 —</div>
                <div class="code">
<pre><span class="c">&lt;!-- 视图：用流式 API 组合控件 --&gt;</span>
@@(F.SimpleForm().ID(<span class="s">"SimpleForm1"</span>).BodyPadding(10).Items(
    F.TextBox().ID(<span class="s">"tbxUser"</span>).Label(<span class="s">"用户名"</span>),
    F.Button().ID(<span class="s">"btnLogin"</span>).Text(<span class="s">"登录"</span>)
        .OnClick(Url.Action(<span class="s">"btnLogin_Click"</span>), <span class="s">"SimpleForm1"</span>),
    F.Label().ID(<span class="s">"lblHi"</span>)
))

<span class="c">// 控制器：点击事件直达 Action 方法，读取并回写控件状态</span>
[<span class="k">HttpPost</span>]
<span class="k">public IActionResult</span> btnLogin_Click(IFormCollection values) {
    <span class="k">var</span> user = values[<span class="s">"tbxUser"</span>];                        <span class="c">// 读控件状态</span>
    UIHelper.Label(<span class="s">"lblHi"</span>).Text(<span class="s">"你好，"</span> + user);   <span class="c">// 写控件状态 → 自动回传前端</span>
    <span class="k">return</span> UIHelper.Result();
}</pre>
                </div>
                <div class="cap">状态自动往返、事件直达后端——不写一行 JavaScript。</div>
            </div>

            <div class="foot">← 从左侧菜单选择页面，将在此工作区以选项卡打开</div>
        </div>
    </div>

    @(F.Panel().ID("mainPanel").ShowHeader(false).ShowBorder(false).Layout(LayoutType.Region).CssClass("mainpanel").IsViewPort(true)
        .Items(
            F.Panel().ID("sidebarRegion").CssClass("sidebarregion").RegionPosition(Position.Left).Width(260).Layout(LayoutType.VBox).ShowBorder(false).ShowHeader(false).RegionSplit(true).RegionSplitIcon(false).RegionSplitWidth(3).RegionSplitTransparent(true)
                .Items(
                    F.Panel().ShowHeader(false).ShowBorder(false).CssClass("topregion").ContentEl("#sideheader"),
                    F.Panel().BoxFlex(1).Layout(LayoutType.Fit).ShowHeader(false).ShowBorder(false).CssClass("leftregion").ID("leftPanel")
                        .Items(
                            F.Tree().ID("treeMenu").ShowBorder(false).ShowHeader(false).EnableSingleClickExpand(true).HideHScrollbar(true).HideVScrollbar(true).ExpanderToRight(true).HeaderStyle(true).AllHeaderStyle(true)
                                .Nodes(
                                    F.TreeNode().Text("默认分类").Expanded(true)
                                        .Nodes(
                                            F.TreeNode().Text("开始页面").NavigateUrl("~/Home/Hello"),
                                            F.TreeNode().Text("登录页面").NavigateUrl("~/Home/Login")
                                        )
                                )
                        )
                ),
            F.Panel().ID("bodyRegion").CssClass("bodyregion").RegionPosition(Position.Center).Layout(LayoutType.VBox).ShowBorder(false).ShowHeader(false)
                .Items(
                    F.Panel().ID("topPanel").ShowHeader(false).ShowBorder(false).CssClass("topregion").ContentEl("#header"),
                    F.TabStrip().BoxFlex(1).ShowInkBar(true).InkBarPosition(InkBarPosition.Bottom).EnableTabCloseMenu(true).ShowBorder(true).RegionPosition(Position.Center).CssClass("centerregion").ID("mainTabStrip")
                        .Tabs(
                            F.Tab().ID("tabHomepage").IconFont(IconFont._Home).Title("首页").BodyPadding(10).ContentEl("#maincontent")
                        )
                )
        )
    )


    @(F.Window().Hidden(true).EnableResize(true).EnableMaximize(true).EnableClose(true).Height(600).Width(850).IsModal(true).ClearIFrameAfterClose(false).IFrameUrl(Url.Content("~/Home/Themes")).EnableIFrame(true).Title("主题仓库").ID("windowThemeRoller"))

    @{
       
    }

}

@section script {

    <script>

        // 点击主题仓库
        function onThemeSelectClick(event) {
            F.ui.windowThemeRoller.show();
        }

        // 点击「个人信息」
        function onUserProfileClick(event) {
            F.alert('尚未实现');
        }

        // 点击「安全退出」
        function onSignOutClick(event) {
            F.alert('尚未实现');
        }

        // 通知框
        function notify(msg) {
            F.notify({
                message: msg,
                messageIcon: 'information',
                target: '_top',
                header: false,
                displayMilliseconds: 3 * 1000,
                positionX: 'center',
                positionY: 'center'
            });
        }

        // 页面控件初始化完毕后，会调用用户自定义的onReady函数
        F.ready(function () {

            if (!F.ui.treeMenu) return;


            // 初始化主框架中的树(或者Accordion+Tree)和选项卡互动，以及地址栏的更新
            // treeMenu： 主框架中的树控件实例，或者内嵌树控件的手风琴控件实例
            // mainTabStrip： 选项卡实例
            // options: 参数
            // options.updateHash： 切换Tab时，是否更新地址栏Hash值（默认值：true）
            // options.refreshWhenExist： 添加选项卡时，如果选项卡已经存在，是否刷新内部IFrame（默认值：false）
            // options.refreshWhenTabChange: 切换选项卡时，是否刷新内部IFrame（默认值：false）
            // options.maxTabCount: 最大允许打开的选项卡数量
            // options.maxTabMessage: 超过最大允许打开选项卡数量时的提示信息
            // options.beforeNodeClick: 节点点击事件之前执行（返回false则不执行点击事件）
            // options.beforeTabAdd: 添加选项卡之前执行（返回false则不添加选项卡）
            // options.moveToEnd: 将选项卡移到尾部（如果选项卡已存在，则不改变位置，默认值：false）
            F.initTreeTabStrip(F.ui.treeMenu, F.ui.mainTabStrip, {
                maxTabCount: 10,
                maxTabMessage: '请先关闭一些选项卡（最多允许打开 10 个）！'
            });

        });
    </script>
}
